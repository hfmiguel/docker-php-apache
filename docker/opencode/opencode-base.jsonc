{
    "$schema": "https://opencode.ai/config.json",
    "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 10000
    },
    "lsp": false,
    "server": {
        "port": 4096,
        "hostname": "{env:OPENCODE_WEB_SERVER_HOST}",
        "mdns": true,
    },
    "instructions": [
        "AGENTS.md",
    ],
    "watcher": {
        "ignore": [
            "node_modules/**",
            "dist/**",
            ".git/**",
            "vendor/**",
            "public/build/**",
            "storage/**",
            "bootstrap/cache/**"
        ]
    },
    "references": {},
    "plugin": [
        "@franlol/opencode-md-table-formatter",
        "envsitter-guard@latest",
    ],
    "permission": {
        "lsp": "deny",
        "skill": "allow",
        "grep": "allow",
        "glob": "allow",
        "mcp-fluxui*": "allow",
        "mcp-laravel-boost*": "allow",
        "mcp-context7*": "allow",
        "mcp-sequential-thinking*": "allow",
        "doom_loop": "allow",
        "task": "allow",
        "external_directory": {
            "*": "deny",
            "/tmp/**": "allow",
            "/tmp": "allow"
        },
        "bash": {
            "*": "ask",
            "docker system *": "deny",
            "* >> *": "deny",
            "* << *": "deny",
            "* && *": "deny",
            "* || *": "deny",
            "| bash": "deny",
            "* ; *": "deny",
            "*$(*)*": "deny",
            "*`*`*": "deny",
            "sudo *": "deny",
            "su *": "deny",
            "rm": "deny",
            "rm *": "deny",
            "* rm *": "deny",
            "ln": "deny",
            "ln *": "deny",
            "rmdir *": "deny",
            "* rmdir *": "deny",
            "*.sh": "deny",
            "bash *": "deny",
            "sh *": "deny",
            "rsync *": "deny",
            "vim": "deny",
            "git stash": "deny",
            "git stash *": "deny",
            "git rebase": "deny",
            "git rebase *": "deny",
            "git force-push": "deny",
            "git force-push *": "deny",
            "git reset": "deny",
            "git reset *": "deny",
            "git restore": "deny",
            "git restore *": "deny",
            "git rm": "deny",
            "git rm *": "deny",
            "git remote set-url": "deny",
            "git remote set-url *": "deny",
            "git commit --amend*": "deny",
            "git checkout -f": "deny",
            "git checkout -f*": "deny",
            "git push *--delete*": "deny",
            "* git stash": "deny",
            "* git stash *": "deny",
            "* git rebase": "deny",
            "* git rebase *": "deny",
            "* git force-push": "deny",
            "* git force-push *": "deny",
            "* git reset": "deny",
            "* git reset *": "deny",
            "* git restore": "deny",
            "* git restore *": "deny",
            "* git rm": "deny",
            "* git rm *": "deny",
            "git reflog *": "deny",
            "git gc *": "deny",
            "git filter-branch *": "deny",
            "git filter-repo *": "deny",
            "git *--no-verify*": "deny",
            "git config *": "deny",
            "git tag -d *": "deny",
            "git push *:*": "deny",
            "git push *--force*": "deny",
            "git push *-f*": "deny",
            "git clean *": "deny",
            "git branch -D *": "deny",
            "git push *": "deny",
            "git branch -d *": "deny",
            "git branch --delete *": "deny",
            "git cherry-pick *": "deny",
            "git revert *": "deny",
            "git merge *": "deny",
            "git switch *": "deny",
            "git worktree *": "deny",
            "git update-ref *": "deny",
            "git replace *": "deny",
            "unlink *": "deny",
            "find * -delete*": "deny",
            "find * -exec*": "deny",
            "truncate *": "deny",
            "dd *": "deny",
            "zsh *": "deny",
            "fish *": "deny",
            "eval *": "deny",
            "exec *": "deny",
            "chmod *": "deny",
            "chown *": "deny",
            "nc *": "deny",
            "netcat *": "deny",
            "ssh *": "deny",
            "docker volume *": "deny",
            "kill *": "deny",
            "pkill *": "deny",
            "killall *": "deny",
            "alias *": "deny",
            "unalias *": "deny",
            "tee *": "deny",
            "xargs *": "deny",
            "aria2c *": "deny",
            "scp *": "deny",
            "sftp *": "deny",
            "mount *": "deny",
            "umount *": "deny",
            "fusermount *": "deny",
            "fusermount3 *": "deny",
            "mkfs *": "deny",
            "mkswap *": "deny",
            "fdisk *": "deny",
            "parted *": "deny",
            "gdisk *": "deny",
            "blkid *": "deny",
            "losetup *": "deny",
            "systemctl *": "deny",
            "service *": "deny",
            "reboot": "deny",
            "shutdown *": "deny",
            "poweroff": "deny",
            "halt": "deny",
            "iptables *": "deny",
            "ip6tables *": "deny",
            "nft *": "deny",
            "ufw *": "deny",
            "crontab *": "deny",
            "at *": "deny",
            "systemd-run *": "deny",
            "passwd *": "deny",
            "chattr *": "deny",
            "lsattr *": "deny",
            "gdb *": "deny",
            "strace *": "deny",
            "ptrace *": "deny",
            "python *": "deny",
            "python3 *": "deny",
            "perl *": "deny",
            "ruby *": "deny",
            "node -e *": "deny",
            "php -r *": "deny",
            "sed -i *": "deny",
            "perl -i *": "deny",
            "cp *": "deny",
            "mv *": "deny",
            "docker create *": "deny",
            "docker start *": "deny",
            "docker update *": "deny",
            "docker inspect *": "deny",
            "docker build *": "deny",
            "docker commit *": "deny",
            "docker network *": "deny",
            "docker image *": "deny",
            "docker container *": "deny",
            "docker exec *": "deny",
            "docker run *": "deny",
            "docker compose run *": "deny",
            "docker compose exec *": "deny",
            "docker cp *": "deny",
            "docker compose cp *": "deny",
            "docker *": "ask",
            "git *": "ask",
            "gh *": "ask",
            "sed -n *": "allow",
            "tail *": "allow",
            "cat *": "allow",
            "grep *": "allow",
            "less *": "allow",
            "glob *": "allow",
            "find *": "allow",
            "head *": "allow",
            "ls *": "allow",
            "wc -l *": "allow",
            "sort *": "allow",
            "rg *": "allow",
            "php artisan *": "allow",
            "cat * | grep *": "allow",
            "git status": "allow",
            "git status *": "allow",
            "git diff": "allow",
            "git diff *": "allow",
            "git log*": "allow",
            "git branch*": "allow",
            "git show*": "allow",
            "git --no-pager status": "allow",
            "git --no-pager status *": "allow",
            "git --no-pager diff": "allow",
            "git --no-pager diff *": "allow",
            "git --no-pager log*": "allow",
            "git --no-pager branch*": "allow",
            "git --no-pager show*": "allow",
            "vendor/bin/pint *": "allow",
            "vendor/bin/pest *": "allow",
            "vendor/bin/phpunit *": "allow",
            "gh issue view *": "allow",
            "gh pr view *": "allow",
        },
        "read": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            ".git/**": "deny",
        },
        "edit": {
            "opencode.json": "deny",
            "vendor/**": "deny",
            "node_modules/**": "deny",
            "public/build/**": "deny",
            "*.sh": "deny",
            ".opencode/agents/**": "deny",
            "*.env": "deny",
            "*.env.*": "deny",
            ".git/**": "deny",
            "/tmp/**": "allow",
            "*.md": "allow",
            "*.env.example": "allow"
        },
        "write": {
            "opencode.json": "deny",
            "vendor/**": "deny",
            "node_modules/**": "deny",
            "public/build/**": "deny",
            "*.sh": "deny",
            ".opencode/agents/**": "deny",
            "*.env": "deny",
            "*.env.*": "deny",
            ".git/**": "deny",
            "/tmp/**": "allow",
            "*.md": "allow",
            "*.env.example": "allow"
        }
    },
    "mcp": {
        "mcp-context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            },
            "enabled": true
        },
        "mcp-deno-sandbox": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "mcp-deno-sandbox",
                "--allow-net",
                "--allow-read=/tmp",
                "--allow-write=/tmp"
            ],
            "enabled": true
        },
        "mcp-sequential-thinking": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "enabled": true
        },
        "mcp-exa-websearch": {
            "enabled": true,
            "type": "remote",
            "url": "https://mcp.exa.ai/mcp"
        },
        "mcp-fluxui": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "fluxui-mcp-server"
            ],
            "enabled": true
        }
    }
}