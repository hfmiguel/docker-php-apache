#### .opencode.env ####
TZ=Europe/Lisbon

### CONFIGURABLE VARS ###
OPENCODE_MAIN_MODEL=""
OPENCODE_WEB_SERVER_HOST=""
UNSLOTH_STUDIO_API_KEY=""
GITHUB_ACCESS_TOKEN_MCP=""
CONTEXT7_API_KEY=""

## OPENWIKI ###
INSTALL_OPENWIKI= # true/false
OPENWIKI_PROVIDER="openai-compatible"
OPENAI_COMPATIBLE_API_KEY=llama
OPENAI_COMPATIBLE_BASE_URL=""
OPENWIKI_MODEL_ID=""
LANGSMITH_API_KEY=""
OPENWIKI_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1

## OPENCHAMBER
INSTALL_OPENCHAMBER= # true/false
OPENCHAMBER_UI_PASSWORD=1234
OPENCHAMBER_PORT=3000

PHP_CONTAINER=""  ### php container to bind inside of opencode that allow run php,composer,node commands
OPENCODE_CONTAINER_NAME=""  ### Container name used by the opencode instance
PROJECT_NETWORK_FULL_NAME="" ### Project network full name; Confirm with `docker network ls` command