FROM python:3.11.16-slim@sha256:9c900dea9e8fb7e16277c179b555cc72d29a352dbc33cff48ad5a0412fd5bfc7

ENV GO_VERSION=1.23.0
ENV GOPATH="/home/www-data/go"
ENV HOME=/home/www-data

ENV PATH="/usr/local/go/bin:${GOPATH}/bin:${HOME}/.opencode/bin:${PATH}"
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV NODE_NO_WARNINGS=1
ENV NODE_OPTIONS="--no-warnings"

### CONFIGURABLE ENV VARS ###
OPENCODE_MAIN_MODEL=""
OPENCODE_WEB_SERVER_HOST=""
UNSLOTH_STUDIO_API_KEY=""
GITHUB_ACCESS_TOKEN_MCP=""
CONTEXT7_API_KEY=""

## OPENWIKI ###
OPENWIKI_PROVIDER="openai-compatible"
OPENAI_COMPATIBLE_API_KEY=llama
OPENAI_COMPATIBLE_BASE_URL=""
OPENWIKI_MODEL_ID=""
LANGSMITH_API_KEY=""
OPENWIKI_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1

## OPENCHAMBER
OPENCHAMBER_UI_PASSWORD=1234
OPENCHAMBER_PORT=3000

RUN export PATH=/home/www-data/.opencode/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    ca-certificates \
    gnupg \
    gosu \
    ripgrep \
    tree \
    fd-find \
    jq \
    procps \
    lsof \
    wget \
    unzip \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    xvfb \
    openssh-client \
    && mkdir -p /etc/apt/keyrings \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker/buildx-bin:latest /buildx /usr/libexec/docker/cli-plugins/docker-buildx
COPY --from=docker/compose-bin:latest /docker-compose /usr/libexec/docker/cli-plugins/docker-compose

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY docker/opencode-entrypoint.sh /etc/opencode-entrypoint.sh
RUN chmod +x /etc/opencode-entrypoint.sh

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && \
    apt-get install -y nsolid && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" | tar -C /usr/local -xzf -

RUN curl -fsSL https://bun.sh/install | bash

RUN curl --proto '=https' --tlsv1.2 -LsSf https://github.com/j178/prek/releases/download/v0.4.13/prek-installer.sh | sh

RUN go install github.com/eljakani/ward@latest

RUN mkdir -p /home/www-data /var/www/projects /ms-playwright ${GOPATH} && \
    groupmod -g 1000 www-data && \
    usermod -u 1000 -g www-data -d /home/www-data www-data

RUN ln -s /bin/true /usr/local/bin/xdg-open

RUN npm install -g playwright@latest && \
    playwright install chromium chrome --force

RUN mkdir -p /home/www-data/.npm
RUN mkdir -p /home/www-data/.cache/composer/
RUN mkdir -p /home/www-data/.opencode/

RUN curl -fsSL https://bun.sh/install | bash

RUN npm install -g openwiki@latest
RUN npm install -g mermaid jsdom
RUN npm install -g @openchamber/web
RUN apt install gh -y

RUN chown -R www-data:www-data /home/www-data /ms-playwright /tmp ${GOPATH}

RUN curl -fsSL https://opencode.ai/install | bash

RUN chown -R www-data:www-data /home/www-data/

WORKDIR /var/www/projects

RUN chown -R www-data:www-data /usr/local/bin

USER www-data

ENTRYPOINT ["/etc/opencode-container-entrypoint.sh"]

CMD ["python3"]